CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# The integrated owner loop, boxed journal handoff, and compact two-pass NVS
# reconstruction have a static nested-frame peak of about 34 KiB in the
# current optimized ESP32-C3 build. Keep explicit headroom for HAL/NVS/BLE
# callees; hardware acceptance records the actual high-water mark before this
# budget is changed again.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=65536
CONFIG_FREERTOS_HZ=1000
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_NVS_PERSIST=n
